{
    "name": "Real-Time Systems Environment",

    "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "lf-lang.vscode-lingua-franca"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.analysis.typeCheckingMode": "basic"
            }
        }
    },

    "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r .devcontainer/requirements.txt && python -m ipykernel install --user --name quantum-env --display-name \"Python (Quantum Environment)\" && curl -Ls https://install.lf-lang.org | bash -s cli --prefix=/home/vscode/.local/ && echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.bashrc && echo \"alias ll='ls -alF'\" >> ~/.bashrc && echo 'Devcontainer setup is complete!'",

    "postStartCommand": "echo 'Welcome to this Real-Time Systems Environment!' && echo 'Lingua Franca:' && lfc --version",

    "remoteUser": "vscode"
}