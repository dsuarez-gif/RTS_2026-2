{
    "name": "Environment for Real-Time Programming",

    "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "lf-lang.vscode-lingua-franca",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools"
            ],

            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.analysis.typeCheckingMode": "basic",

                "cmake.configureOnOpen": false
            }
        }
    },

    "postCreateCommand": "bash .devcontainer/setup.sh",

    "postStartCommand": "echo 'Welcome to this Environment for Real-Time Programming!' && echo '--- Installed versions ---' && cmake --version | head -n 1 && java --version 2>&1 | head -n 1 && gcc --version | head -n 1 && lfc --version",

    "remoteUser": "vscode"
}